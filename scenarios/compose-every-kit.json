{
    "name": "Every kit",
    "group": "Compositions",
    "order": 7,
    "description": "All six worlds and all twenty kits at once, on Entity Origin's real-scale Earth: Entity Cloud's High Plains (structures, buses, vegetation, a named place) with Entity Water's Riverlands, Entity Imposter's valley, Entity Portal's bunker island and Entity GUI's Sector 07 (its easel, radar and CCTV) standing on the plains. One floating-origin camera flies from the river up through the clouds to orbit and the planets; the handheld hands the camera to the facility's player.",
    "entities": [
        {"$comment":"the root: the solar system (entities kit), its Earth carrying a site the plains stand on"},
        {"type":"include","scenario":"origin-sol-transit","as":"sol","root":{"label":"Origin · Sol Transit","layer":{"sky":true}}},
        {"type":"prop","of":"sol","id":"plains-site","label":"High Plains","model":"marker","surface":{"parent":"earth","lat":40,"lon":-104},"sunProbe":true},
        {"type":"bookmark","key":"8","name":"Over the plains","at":{"parent":"plains-site","offset":[1500,2900,14000]},"look":"plains-site"},
        {"type":"bookmark","key":"9","name":"Riverlands","at":{"parent":"plains-site","offset":[5200,520,7000]},"look":"plains-site"},
        {"type":"bookmark","name":"High over the plains","at":{"parent":"plains-site","offset":[-8000,14000,30000]},"look":"plains-site"},
        {"type":"start","value":"8"},

        {"$comment":"the sky: the atmosphere over everything below it (atmosphere, terrain, weather, curvature, settlement, building, transit, geo, imposter for its plants); its ground 1300 m lower so it lies on the Earth's surface, its curvature the Earth's"},
        {"type":"include","scenario":"cloud-high-plains","as":"sky","skip":["view"],
            "root":{"label":"Cloud · High Plains","layer":{"role":"atmosphere","transform":{"anchor":"sol:plains-site","offset":[0,-1300,0]}}}},
        {"type":"terrain","of":"sky","vegetation":true},
        {"type":"render","radar":false},
        {"type":"weather","start":"fair cumulus"},
        {"$comment":"a named place on the plains: the geo kit's label, no imported data"},
        {"type":"place","of":"sky","label":"Every Kit Junction","pos":[2000,9000],"range":30000},

        {"$comment":"the river (hydrology), cut into the plains with its lakes"},
        {"type":"include","scenario":"water-riverlands","as":"river","skip":["sound.*"],
            "root":{"label":"Water · Riverlands","layer":{"transform":{"anchor":"sol:plains-site","offset":[6000,95,6000]}}}},
        {"type":"clearing","of":"sky","label":"","pos":[6000,6000],"size":[2048,2048],"level":1370,"blend":260,"inset":true},
        {"type":"lake","of":"sky","label":"","pos":[5300,7900],"radius":1300,"level":1397},
        {"type":"lake","of":"sky","label":"","pos":[6700,7900],"radius":1300,"level":1397},
        {"type":"light","of":"river","id":"plains day","sun":{"azimuth":62,"elevation":14,"color":[1,0.84,0.66],"intensity":3.0},
            "sky":{"top":[0.3,0.45,0.72],"horizon":[0.72,0.74,0.78]},"ground":[0.24,0.22,0.18],"ambient":0.55,"fog":0.000004,"exposure":0.62},
        {"type":"lighting","of":"river","start":"plains day"},
        {"type":"link","to":"river.rain","value":"sky.rain > 0.05"},
        {"$comment":"the sky's atmosphere ends where space begins: above 40 km (or near another body) the solar system shows bare"},
        {"type":"link","to":"sky.visible","value":"sol.body == 'Earth' && sol.altitude < 40000"},

        {"$comment":"the valley (imposter): meshes near, octahedral imposters far, sun shadows"},
        {"type":"include","scenario":"imposter-valley","as":"valley","skip":["sound.*"],
            "root":{"label":"Imposter · Valley","layer":{"transform":{"anchor":"sol:plains-site","offset":[14000,138,-2000]}}}},
        {"type":"clearing","of":"sky","label":"","pos":[14000,-2000],"size":[3200,3200],"level":1395,"blend":300,"inset":true},
        {"type":"light","of":"valley","id":"plains afternoon","sun":{"azimuth":118,"elevation":14,"color":"#ffd2a8","intensity":2.6},
            "sky":{"top":"#4a6fa8","horizon":"#c8cdd2"},"ambient":{"sky":"#9fb6d6","ground":"#6a604c","strength":0.5},
            "fog":{"color":"#c4ccd6","density":0.00008},"exposure":1,"emission":0.05},
        {"type":"environment","value":"plains afternoon"},

        {"$comment":"the bunker island (interior, building, transit, media): areas and portals, its freighter, drones, screens"},
        {"type":"include","scenario":"portal-bunker-compound","as":"bunker","skip":["sound.*"],
            "root":{"label":"Portal · Bunker","layer":{"transform":{"anchor":"sol:plains-site","offset":[-11000,221.2,15000]}}}},
        {"type":"outdoor","fog":[0.62,0.66,0.72,0.0012],"sunDir":[0.857,0.242,-0.456],"sunColor":[1.1,0.95,0.8]},

        {"$comment":"the facility (gui, media, paint): world-space GUIs, CCTV, the easel, the radar; seen from outside it needs a far plane past its 100 m"},
        {"type":"include","scenario":"gui-sector-07","as":"sector","skip":["hud.toast","sound.*"],
            "root":{"label":"GUI · Sector 07","layer":{"transform":{"anchor":"sol:plains-site","offset":[2000,200,9000]}}}},
        {"type":"clearing","of":"sky","label":"","pos":[2000,9000],"size":[400,400],"level":1500,"blend":200,"inset":true},
        {"type":"player","of":"sector","far":4000},
        {"type":"handheld","startShown":false},
        {"type":"facility","fog":0.0005,"ambient":0.12},

        {"$comment":"the camera: sol's floating-origin flight, or (the handheld's Keys) the facility's player"},
        {"type":"camera","from":["sol","sector"],"carry":false},
        {"$comment":"the handheld's pages: scenarios/gui/compose-every-kit.json","type":"include","scenario":"gui/compose-every-kit"}
    ]
}

{
    "name": "Storm over Riverlands",
    "group": "Compositions",
    "order": 1,
    "description": "Entity Water's river simulation set into Entity Cloud's High Plains: the clouds, rain shafts, haze and lightning are drawn over the river world, and rain falling where the camera is turns on the river's rain.",
    "entities": [
        {"$comment":"the sky: High Plains, as the composition's atmosphere (the other worlds go into its scene before its volumetrics)"},
        {"type":"include","scenario":"cloud-high-plains","as":"sky","skip":["cloud.view"],
            "root":{"label":"Cloud · High Plains","layer":{"role":"atmosphere"}}},
        {"type":"cloud.render","radar":false},
        {"$comment":"the plains sink under the river map (inset: the ground meets its edges at their own height), and the sea goes on south of it"},
        {"type":"cloud.clearing","label":"","pos":[6000,6000],"size":[2048,2048],"level":1370,"blend":260,"inset":true},
        {"type":"cloud.lake","label":"","pos":[5300,7900],"radius":1300,"level":1397},
        {"type":"cloud.lake","label":"","pos":[6700,7900],"radius":1300,"level":1397},

        {"$comment":"the river: Riverlands, 1395 m up on the plains; it drives the camera and has the keys first"},
        {"type":"include","scenario":"water-riverlands","as":"river",
            "root":{"label":"Water · Riverlands","layer":{"transform":{"offset":[6000,1395,6000]},"focus":true}}},
        {"type":"water.light","id":"plains day","sun":{"azimuth":62,"elevation":14,"color":[1,0.84,0.66],"intensity":3.0},
            "sky":{"top":[0.3,0.45,0.72],"horizon":[0.72,0.74,0.78]},"ground":[0.24,0.22,0.18],"ambient":0.55,"fog":0.000004,"exposure":0.62},
        {"type":"water.light","id":"plains golden","sun":{"azimuth":285,"elevation":7,"color":[1,0.6,0.32],"intensity":3.0},
            "sky":{"top":[0.18,0.26,0.5],"horizon":[0.9,0.6,0.42]},"ground":[0.22,0.16,0.12],"ambient":0.45,"fog":0.000005,"exposure":0.7},
        {"type":"water.light","id":"plains night","sun":{"azimuth":160,"elevation":40,"color":[0.6,0.7,1.0],"intensity":0.35},
            "sky":{"top":[0.02,0.03,0.06],"horizon":[0.05,0.06,0.09]},"ground":[0.05,0.05,0.05],"ambient":0.25,"fog":0.000005,"exposure":1.2},
        {"type":"water.lighting","start":"plains day"},

        {"type":"camera","from":"river"},

        {"$comment":"what joins them"},
        {"type":"link","to":"river.rain","value":"sky.rain > 0.05"},
        {"type":"link","to":"river.light","value":"sky.light == 'golden' || sky.light == 'storm dusk' ? 'plains golden' : contains(sky.light, 'moon') || sky.light == 'crescent' ? 'plains night' : 'plains day'"},

        {"type":"hud.panel","id":"composition","anchor":"right","class":"small","lines":[
            "<span class=\"t\">STORM OVER RIVERLANDS</span>",
            "weather   <b>{sky.weather}</b> · {sky.light}",
            "rain here {sky.rain|pct} → river rain {river.rain|onoff}",
            "storms    {sky.cells} cells · {sky.flashes} flashes",
            "river     {river.volume|num: m³} · {river.maxSpeed|1} m/s",
            "<span class=\"m\">keys: {focus} (` cycles: the sky takes</span>",
            "<span class=\"m\">1-9 weather, T lighting, K lightning)</span>"]}
    ]
}

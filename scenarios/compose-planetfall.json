{
    "name": "Planetfall",
    "group": "Compositions",
    "order": 4,
    "description": "Entity Imposter's valley set on Entity Origin's real-scale Earth: one floating-origin camera flies from the valley floor up to Gateway Station in orbit and on to Neptune, the valley staying exact under it. The valley's sun is the solar system's.",
    "entities": [
        {"type":"include","scenario":"origin-sol-transit","as":"sol","root":{"label":"Origin · Sol Transit","layer":{"sky":true,"focus":true}}},
        {"$comment":"where the valley stands: a site on the day side of the Earth, its frame the ground's (y up); sunProbe: its sun direction is in sol's stats"},
        {"type":"origin.prop","id":"valley-site","label":"Imposter Valley","model":"marker","surface":{"parent":"earth","lat":30,"lon":160},"sunProbe":true},
        {"type":"origin.bookmark","key":"8","name":"Imposter Valley, Earth","at":{"parent":"valley-site","offset":[-60,46,280]},"look":"valley-site"},
        {"type":"origin.bookmark","key":"9","name":"Above the valley","at":{"parent":"valley-site","offset":[0,4000,9000]},"look":"valley-site"},
        {"type":"origin.start","value":"8"},

        {"$comment":"the valley rides on the site, 30 m up so its lowest ground stays above the sphere (the Earth curves 0.2 m away over its 1.6 km)"},
        {"type":"include","scenario":"imposter-valley","as":"valley",
            "root":{"label":"Imposter · Valley","layer":{"transform":{"anchor":"sol:valley-site","offset":[0,30,0]}}}},
        {"type":"imposter.shadows","distance":800},

        {"type":"camera","from":"sol"},
        {"$comment":"the valley's sun is the Sun as seen from the site"},
        {"type":"link","to":"valley.sunDir","value":"sol.sunAt['valley-site']"},
        {"type":"link","to":"valley.light","value":"sol.sunAt['valley-site'][1] < 0.03 ? 'night' : 'noon'"},
        {"type":"handheld.page","id":"planetfall","title":"Planetfall","nav":{"section":"SCENARIO","sub":"Where the valley stands","icon":[[88,86,214],"P"]},"sections":[{"header":"ORIGIN","cells":[{"type":"label","title":"Near","expr":"{sol.body}"},{"type":"label","title":"Altitude","expr":"{sol.altitude|dist}"},{"type":"label","title":"Scale","expr":"{sol.scale} m/unit"},{"type":"label","title":"Rebases","expr":"{sol.rebases}"}]},{"header":"VALLEY","cells":[{"type":"label","title":"Light","expr":"{valley.light}"},{"type":"label","title":"Instances","expr":"{valley.instances|int}"}],"footer":"8 the valley · 9 above it · 1 Gateway Station."}]}
    ]
}

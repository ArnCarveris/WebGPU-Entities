            {"shot":{"source":"white","filter":"wet ? 'bandpass' : 'highpass'","freq":"wet ? 1800 : 2500","q":"wet ? 1.2 : 0.5","env":[[0.005,"(run ? 0.16 : 0.11) * (wet ? 0.6 : 0.3)"],["wet ? 0.18 : 0.07",0]]}}]},

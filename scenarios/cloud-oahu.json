        {"$comment":"the sound of the weather around the camera"},
        {"type":"sound.bed","id":"rain","source":"white","filters":[["highpass",500,0.7],["lowpass",7000,0.7]],
            "gain":"pow(cloud.rain, 0.7) * 0.3 * (cloud.inside ? 0.25 : cloud.sheltered ? 0.55 : 1)","filter":[1,"cloud.inside ? 1400 : 7000"],"smooth":0.25},
        {"type":"sound.bed","id":"wind","source":"brown","filters":[["bandpass",350,0.9]],"smooth":0.6,
            "gain":"(clamp(cloud.wind / 25) * 0.12 * (0.6 + 0.4 * smoothstep(0, 400, cloud.agl)) * (0.7 + 0.3 * sin(cloud.time * 0.37) * sin(cloud.time * 0.13 + 1.3)) + smoothstep(200, 3000, cloud.agl) * 0.05) * (cloud.inside ? 0.15 : 1)",
            "filter":[0,"250 + 300 * (0.7 + 0.3 * sin(cloud.time * 0.37) * sin(cloud.time * 0.13 + 1.3)) + cloud.wind * 6"]},

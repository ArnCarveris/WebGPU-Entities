{
    "$comment": "the handheld's pages of Grand tour of the plains (scenarios/compose-grand-tour.json includes them)",
    "entities": [
        {
            "type": "handheld.page",
            "id": "tour",
            "title": "Grand Tour",
            "nav": {"section":"SCENARIO","sub":"Every world at a glance","icon":[[255,45,85],"G"]},
            "sections": [
                {
                    "header": "WORLDS",
                    "cells": [
                        {"type":"label","title":"Weather","expr":"{sky.weather}"},
                        {"type":"label","title":"Storm cells","expr":"{sky.cells}"},
                        {"type":"label","title":"River volume","expr":"{river.volume|num: m³}"},
                        {"type":"label","title":"River rain","expr":"{river.rain ? 'on' : 'off'}"},
                        {"type":"label","title":"Valley instances","expr":"{valley.instances|int}"},
                        {"type":"label","title":"Bunker area","expr":"{bunker.area}"}
                    ]
                }
            ]
        },
        {
            "type": "handheld.page",
            "id": "flight",
            "title": "Engine camera",
            "nav": {"section":"SCENARIO","sub":"The free camera of this tour","icon":[[142,142,147],"E"]},
            "sections": [
                {
                    "header": "MOVE",
                    "cells": [
                        {"type":"label","title":"Look","value":"drag"},
                        {"type":"label","title":"Move","value":"W A S D"},
                        {"type":"label","title":"Up / down","value":"Space / C"},
                        {"type":"label","title":"Faster","value":"Shift ×5"},
                        {"type":"label","title":"Speed","value":"wheel"},
                        {"type":"label","title":"Viewpoints","value":"view… in the bar"}
                    ]
                },
                {
                    "header": "WORLDS",
                    "cells": [
                        {"type":"label","title":"Keys to the next world","value":"`"},
                        {"type":"label","title":"Hide a world","value":"untick it in the bar"},
                        {"type":"label","title":"One world alone","value":"Alt+click its name"}
                    ],
                    "footer": "The sky takes 1-9 weather, T lighting, K lightning; the river R rain, X dams. Each world's own page under Controls."
                }
            ]
        }
    ]
}

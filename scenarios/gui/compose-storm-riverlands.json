{
    "$comment": "the handheld's pages of Storm over Riverlands (scenarios/compose-storm-riverlands.json includes them)",
    "entities": [
        {
            "type": "handheld.page",
            "id": "storm",
            "title": "Storm",
            "nav": {"section":"SCENARIO","sub":"Weather and the river","icon":[[0,122,255],"S"]},
            "sections": [
                {
                    "header": "WEATHER",
                    "cells": [
                        {"type":"label","title":"Weather","expr":"{sky.weather}"},
                        {"type":"label","title":"Light","expr":"{sky.light}"},
                        {"type":"label","title":"Rain here","expr":"{sky.rain|pct}"},
                        {"type":"label","title":"Storm cells","expr":"{sky.cells}"},
                        {"type":"label","title":"Flashes","expr":"{sky.flashes}"}
                    ]
                },
                {
                    "header": "RIVER",
                    "cells": [
                        {"type":"label","title":"Rain","expr":"{river.rain ? 'on' : 'off'}"},
                        {"type":"label","title":"Volume","expr":"{river.volume|num: m³}"},
                        {"type":"label","title":"Fastest flow","expr":"{river.maxSpeed|1} m/s"}
                    ],
                    "footer": "` cycles the keys: the sky takes 1-9 weather, T lighting, K lightning."
                }
            ]
        }
    ]
}

{
    "$comment": "the handheld's pages of Planetfall (scenarios/compose-planetfall.json includes them)",
    "entities": [
        {
            "type": "handheld.page",
            "id": "planetfall",
            "title": "Planetfall",
            "nav": {"section":"SCENARIO","sub":"Where the valley stands","icon":[[88,86,214],"P"]},
            "sections": [
                {
                    "header": "ORIGIN",
                    "cells": [
                        {"type":"label","title":"Near","expr":"{sol.body}"},
                        {"type":"label","title":"Altitude","expr":"{sol.altitude|dist}"},
                        {"type":"label","title":"Scale","expr":"{sol.scale} m/unit"},
                        {"type":"label","title":"Rebases","expr":"{sol.rebases}"}
                    ]
                },
                {
                    "header": "VALLEY",
                    "cells": [
                        {"type":"label","title":"Light","expr":"{valley.light}"},
                        {"type":"label","title":"Instances","expr":"{valley.instances|int}"}
                    ],
                    "footer": "8 the valley · 9 above it · 1 Gateway Station."
                }
            ]
        }
    ]
}

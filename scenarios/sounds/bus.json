{
    "$comment": "The buses' sounds, shared: any cloud world with buses includes them ({ \"type\": \"include\", \"scenario\": \"sounds/bus\" }). They follow the nearest bus (cloud.busDist, busSpeed m/s, busLoad 0..1: how hard its engine works, busBraking; riding: the camera in its cabin, at the wheel too) and its events (busDoor, busHiss: it comes to rest, busBump: driven into something). Each bed is loudest aboard and fades out within 300 m.",
    "entities": [
        {"$comment":"the diesel: a low sawtooth, idling at 28 Hz, up with the speed and the throttle","type":"sound.bed","id":"bus-engine","source":"osc","wave":"sawtooth","freq":28,"filters":[["lowpass",260,0.7],["lowpass",220,0.7]],"smooth":0.3,
            "gain":"0.12 * (cloud.riding ? 1 : cloud.busDist < 300 ? 1.4 / (1 + cloud.busDist / 12) : 0) * (0.45 + 0.35 * clamp(cloud.busSpeed / 12) + 0.45 * cloud.busLoad)",
            "pitch":"28 + cloud.busSpeed * 2.4 + cloud.busLoad * 10"},
        {"$comment":"its gearbox and turbo whine, under load","type":"sound.bed","id":"bus-whine","source":"osc","wave":"triangle","freq":220,"filters":[["bandpass",600,2]],"smooth":0.25,
            "gain":"0.02 * (cloud.riding ? 1 : cloud.busDist < 300 ? 1.4 / (1 + cloud.busDist / 12) : 0) * cloud.busLoad * clamp(cloud.busSpeed / 8)",
            "pitch":"220 + cloud.busSpeed * 22"},
        {"$comment":"the body and the road under it","type":"sound.bed","id":"bus-rumble","source":"brown","filters":[["lowpass",220,0.7]],"smooth":0.25,
            "gain":"0.35 * (cloud.riding ? 1 : cloud.busDist < 300 ? 1.4 / (1 + cloud.busDist / 12) : 0) * (0.25 + 0.75 * clamp(cloud.busSpeed / 12))"},
        {"$comment":"the tyres on the road: a hiss growing with the speed, louder on a wet road","type":"sound.bed","id":"bus-tyres","source":"white","filters":[["bandpass",1100,0.8]],"smooth":0.3,
            "gain":"0.06 * (cloud.riding ? 0.6 : cloud.busDist < 300 ? 1.4 / (1 + cloud.busDist / 12) : 0) * pow(clamp(cloud.busSpeed / 25), 1.5) * (1 + 3 * cloud.rain)"},
        {"$comment":"the brakes while it slows","type":"sound.bed","id":"bus-brakes","source":"white","filters":[["highpass",3500,0.7]],"smooth":0.1,
            "gain":"cloud.busBraking ? 0.05 * (cloud.riding ? 1 : cloud.busDist < 300 ? 1.4 / (1 + cloud.busDist / 12) : 0) * clamp(cloud.busSpeed / 10) : 0"},
        {"type":"sound.cue","on":"busDoor","when":"dist < 80","parts":[
            {"shot":{"source":"white","filter":"highpass","freq":3000,"q":0.7,"env":[[0.03,"0.35 / (1 + dist / 5)"],[0.5,"0.175 / (1 + dist / 5)"],[0.9,0]]}},
            {"shot":{"source":"brown","filter":"lowpass","freq":140,"q":1,"env":[[0.01,"0.525 / (1 + dist / 5)"],[0.2,0]]},"delay":0.9}]},
        {"$comment":"the air brakes letting go as it comes to rest","type":"sound.cue","on":"busHiss","when":"dist < 80","parts":[
            {"shot":{"source":"white","filter":"highpass","freq":2200,"q":0.7,"env":[[0.02,"0.3 / (1 + dist / 6)"],[0.7,"0.12 / (1 + dist / 6)"],[1.3,0]]}}]},
        {"$comment":"driven into something: a thump and a clank","type":"sound.cue","on":"busBump","when":"dist < 100","parts":[
            {"shot":{"source":"brown","filter":"lowpass","freq":120,"q":1,"env":[[0.005,"min(1, speed / 6) * 0.8 / (1 + dist / 6)"],[0.35,0]]}},
            {"shot":{"source":"white","filter":"bandpass","freq":900,"q":6,"env":[[0.003,"min(1, speed / 6) * 0.3 / (1 + dist / 6)"],[0.25,0]]}}]}
    ]
}

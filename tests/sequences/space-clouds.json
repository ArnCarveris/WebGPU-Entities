{
  "description": "Clouds from space: Earth's clouds are its cloud source's (its layer and the storms in it, and those of the atmosphere standing on it), so the hurricane off Baja shows its eye (the sea) in its eyewall and dense overcast (white) from 400 km, and every kit's tornadic supercell its anvil over the plains, brighter than the clouds about it (the plains' low afternoon sun: a lower threshold).",
  "scenarios": [
    "compose-every-kit",
    "origin-sol-transit"
  ],
  "steps": [
    {
      "action": "open"
    },
    {
      "action": "step",
      "frames": 40
    },
    {
      "action": "eval",
      "expr": "entities.viewList.find(v => v.name === 'Hurricane from orbit')?.key",
      "as": "hurricane"
    },
    {
      "action": "view",
      "key": {
        "$": "hurricane"
      },
      "frames": 30
    },
    {
      "action": "capture",
      "name": "hurricane-400km"
    },
    {
      "action": "pixels",
      "name": "hurricane-400km",
      "region": [
        470,
        290,
        20,
        20
      ],
      "where": "r > 160 && g > 160 && b > 160",
      "as": "eye",
      "max": 0.25
    },
    {
      "action": "pixels",
      "name": "hurricane-400km",
      "region": [
        540,
        290,
        40,
        20
      ],
      "where": "r > 160 && g > 160 && b > 160",
      "as": "east",
      "min": 0.6
    },
    {
      "action": "pixels",
      "name": "hurricane-400km",
      "region": [
        380,
        290,
        40,
        20
      ],
      "where": "r > 160 && g > 160 && b > 160",
      "as": "west",
      "min": 0.6
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "expect",
      "expr": "entities.sites.find(s => s.id === 'sol').world.app.renderer.frameData[48]",
      "gte": 2,
      "label": "the plains' storm cells are in Earth's clouds (Site.clouds), beside its hurricane"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "expect",
      "expr": "entities.sites.find(s => s.id === 'sky').world.app.world.ext.storms.tornadoHost?.id",
      "equals": "twister",
      "label": "a tornado under the supercell"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "eval",
      "expr": "entities.viewList.find(v => v.name === 'Supercell from orbit')?.key",
      "as": "supercell"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "view",
      "key": {
        "$": "supercell"
      },
      "frames": 30
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "capture",
      "name": "supercell-400km"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "pixels",
      "name": "supercell-400km",
      "region": [
        450,
        200,
        60,
        140
      ],
      "where": "r > 140 && g > 140 && b > 140",
      "as": "anvil",
      "min": 0.7,
      "note": "the anvil: a plume some 250 km long north on the wind aloft, up the middle of the view, brighter than the cumulus"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "pixels",
      "name": "supercell-400km",
      "region": [
        405,
        200,
        20,
        120
      ],
      "where": "r > 140 && g > 140 && b > 140",
      "as": "shadow",
      "max": 0.3,
      "note": "its shadow on the cloud beside it"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "pixels",
      "name": "supercell-400km",
      "region": [
        120,
        280,
        60,
        40
      ],
      "where": "r > 140 && g > 140 && b > 140",
      "as": "upwind",
      "max": 0.3,
      "note": "the patchy cumulus away from it"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "texture",
      "name": "supercell-400km",
      "region": [
        450,
        180,
        60,
        160
      ],
      "as": "anvilTexture",
      "min": 2.5,
      "note": "its top no flat sheet: the overshooting dome lit on its sunward side and dark on the other, bubbly, the gravity waves rippling out over the anvil from it"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "eval",
      "expr": "entities.viewList.find(v => v.name === 'Supercell from 2000 km')?.key",
      "as": "supercell-2000km"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "view",
      "key": {
        "$": "supercell-2000km"
      },
      "frames": 30
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "capture",
      "name": "supercell-2000km"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "eval",
      "expr": "entities.viewList.find(v => v.name === 'Supercell, oblique')?.key",
      "as": "supercell-oblique"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "view",
      "key": {
        "$": "supercell-oblique"
      },
      "frames": 30
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "capture",
      "name": "supercell-oblique"
    },
    {
      "only": [
        "compose-every-kit"
      ],
      "action": "texture",
      "name": "supercell-oblique",
      "as": "textureOblique",
      "region": [
        380,
        215,
        280,
        110
      ],
      "min": 2.6,
      "note": "seen slanting from 110 km: the dome standing out of the sheet, the ripples across it, the edge feathered downwind"
    },
    {
      "action": "errors"
    }
  ]
}
